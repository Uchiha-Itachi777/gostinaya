# Скопируй этот файл в .env и заполни.
# Строки подключения берутся в Neon (neon.tech) -> Connection Details.
# DATABASE_URL — с pooler (для работы приложения), DIRECT_URL — без pooler (для prisma db push).
DATABASE_URL="postgresql://user:password@host-pooler.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

# Любая длинная случайная строка
JWT_SECRET="замени-на-длинную-случайную-строку"

# Ключ из https://aistudio.google.com (используется на этапе 4)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

PORT=3000
